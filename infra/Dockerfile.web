FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY packages/docker/package.json packages/docker/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
RUN npm install --workspace=@laptop-paas/shared --workspace=@laptop-paas/web --include-workspace-root=false

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps/web ./apps/web
COPY packages/shared packages/shared
COPY apps/web apps/web
COPY package.json ./
ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build -w @laptop-paas/shared && npm run build -w @laptop-paas/web \
  && echo "standalone tree:" \
  && find apps/web/.next/standalone -maxdepth 3 -type f -name 'server.js' -o -name 'package.json' | head -40 \
  && test -d apps/web/.next/standalone/apps/web/.next/server/app/signup \
  && test -f apps/web/.next/server/app/signup.html \
  && echo "OK: /signup present in standalone build"

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /app/apps/web/.next/standalone ./
# Static assets: cover both possible standalone layouts
COPY --from=build /app/apps/web/.next/static ./.next/static
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./public
COPY --from=build /app/apps/web/public ./apps/web/public
COPY infra/docker-entrypoint-web.sh /entrypoint-web.sh
RUN chmod +x /entrypoint-web.sh
EXPOSE 3000
ENTRYPOINT ["/entrypoint-web.sh"]
