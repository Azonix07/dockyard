# Bootstrap / fallback config for Runbase.
#
# The worker overwrites this file with the generated route table. Caddy falls
# back to this copy when the generated file fails validation, so it must always
# keep the platform itself reachable.
{
  auto_https off
  admin 0.0.0.0:2019
  persist_config off
  servers {
    timeouts {
      read_body 0
      read_header 20s
      idle 10m
    }
  }
}

:80 {
  encode zstd gzip

  handle /__runbase/health {
    header Content-Type "text/plain; charset=utf-8"
    header Cache-Control "no-store"
    respond "ok proxy=caddy routes=0 (bootstrap config)" 200
  }

  handle /api/* {
    reverse_proxy api:8080 {
      lb_try_duration 25s
      lb_try_interval 250ms
      fail_duration 0
      transport http {
        dial_timeout 5s
        keepalive 2m
      }
    }
  }

  handle {
    reverse_proxy web:3000 {
      lb_try_duration 25s
      lb_try_interval 250ms
      fail_duration 0
      transport http {
        dial_timeout 5s
        keepalive 2m
      }
    }
  }

  handle_errors {
    header Content-Type "text/plain; charset=utf-8"
    header Cache-Control "no-store"
    header Retry-After "3"
    header Access-Control-Allow-Origin "*"
    header X-Runbase-Error "backend_unavailable"
    respond "Runbase: this service is starting or restarting. Retry in a moment." 503
  }
}
