# Platform
ADMIN_TOKEN=change-me-to-a-long-random-string
DATABASE_URL=postgres://paas:paas@localhost:5432/paas
PORT=8080
WEB_ORIGIN=http://localhost:3100
# Production web origin: https://runbase.in
# Tailscale MagicDNS name of the Windows host
PUBLIC_HOST=abhinand
DATA_DIR=/var/lib/laptop-paas
DOCKER_HOST=unix:///var/run/docker.sock
CADDY_ADMIN_URL=http://caddy:2019

# Leave empty: browser uses http://<host>:8180
NEXT_PUBLIC_API_URL=

# Host ports (compose maps these). Defaults avoid Gamespot on 3000/8080.
# WEB http://<host>:3100  API http://<host>:8180  PROXY http://<host>:80
WEB_PORT=3100
API_PORT=8180
PROXY_PORT=80

DEFAULT_MEMORY_LIMIT=536870912
DEFAULT_CPU_NANO=1000000000

GITHUB_WEBHOOK_SECRET=
ALLOW_INSECURE_WEBHOOKS=false
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# GitHub OAuth App (Connect GitHub → list repos). Callback:
#   {GITHUB_OAUTH_CALLBACK_BASE}/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_BASE=https://abhinand.tail8a4b6e.ts.net:8444
GITHUB_APP_SLUG=runbase

# Public HTTPS base Vercel frontends use to reach Runbase backends at
# /p/<project>. This MUST point at the Caddy proxy (tailscale serve 8443 ->
# 127.0.0.1:80), not at the API port — the API has no /p/* routes.
# Run scripts/tailscale-serve.ps1 on the host to set the mapping up.
PUBLIC_APP_BASE=https://abhinand.tail8a4b6e.ts.net:8443

# Vercel account binding (OAuth). Without these, Connect still works as a
# one-time account bind that is stored on the Runbase user / platform admin.
# Create a private integration: vercel.com/dashboard/integrations/console
# Redirect URL: {VERCEL_OAUTH_CALLBACK_BASE}/api/vercel/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_OAUTH_CALLBACK_BASE=https://abhinand.tail8a4b6e.ts.net:8444
VERCEL_INTEGRATION_SLUG=

# AES key for OAuth tokens at rest (defaults to ADMIN_TOKEN if unset)
TOKEN_ENCRYPTION_KEY=

# Comma-separated extra CORS origins (WEB_ORIGIN is always allowed)
CORS_EXTRA_ORIGINS=

KERALA_TARIFF=lt7a_commercial
# lt7a_commercial | lt7b_commercial | lt1_domestic
KERALA_PHASE=single
KERALA_CONNECTED_KW=1

# ---------------------------------------------------------------- reliability
# How long Caddy holds a request while a container is restarting before it
# gives up. This is what turns a redeploy from "502 for 10 seconds" into
# "one slightly slow request".
PROXY_TRY_DURATION_SEC=25

# How long a fresh container gets to bind its port before a deploy is failed.
DEPLOY_READINESS_TIMEOUT_MS=90000

# Self-heal sweep: re-creates missing containers, reattaches them to the proxy
# network and re-publishes the route table. 0 disables it.
WORKER_RECONCILE_MS=20000

# Job polling fallback. The API also sends NOTIFY, so this is only a safety net.
WORKER_POLL_MS=2500

# Postgres pool (WSL2 drops idle sockets — keepalive is on by default)
PG_POOL_MAX=16
PG_POOL_MIN=2
PG_STATEMENT_TIMEOUT_MS=20000

# Upstreams published through the proxy port
PROXY_API_UPSTREAM=api:8080
PROXY_WEB_UPSTREAM=web:3000

LOG_LEVEL=info
