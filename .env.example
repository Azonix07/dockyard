# Platform
ADMIN_TOKEN=change-me-to-a-long-random-string
DATABASE_URL=postgres://paas:paas@localhost:5432/paas
PORT=8080
WEB_ORIGIN=http://localhost:3000
# Tailscale MagicDNS name of the Windows host (used for project hostnames)
PUBLIC_HOST=localhost
DATA_DIR=/var/lib/laptop-paas
DOCKER_HOST=unix:///var/run/docker.sock
CADDY_ADMIN_URL=http://caddy:2019

# Leave empty so the browser uses http://<current-host>:8080 (works over Tailscale)
NEXT_PUBLIC_API_URL=

# Resource defaults (bytes / nanoCPUs)
DEFAULT_MEMORY_LIMIT=536870912
DEFAULT_CPU_NANO=1000000000

# GitHub — REQUIRED for production webhooks (set a strong secret)
GITHUB_WEBHOOK_SECRET=
# Local testing only — never enable on Funnel/public exposure
ALLOW_INSECURE_WEBHOOKS=false
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

DOCKER_PRUNE_AFTER_DEPLOY=true
